{
    "name": "always-open/laravel-pivot",
    "description": "This package introduces new eloquent events for sync(), attach(), detach() or updateExistingPivot() methods on BelongsToMany relation.",
    "keywords": [
        "laravel BelongsToMany events",
        "eloquent extra events",
        "laravel pivot events",
        "laravel sync events",
        "eloquent events"
    ],
    "homepage": "https://github.com/always-open/laravel-pivot",
    "support": {
        "issues": "https://github.com/always-open/laravel-pivot/issues",
        "source": "https://github.com/always-open/laravel-pivot"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Filip Horvat",
            "email": "filip.horvat@am2studio.hr",
            "homepage": "http://am2studio.hr",
            "role": "Developer"
        },
        {
            "name": "always-open",
            "homepage": "https://github.com/always-open",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0"
    },
    "replace": {
        "fico7489/laravel-pivot": "self.version"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/extension-installer": "^1.3||^2.0"
    },
    "autoload": {
        "psr-4": {
            "Fico7489\\Laravel\\Pivot\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fico7489\\Laravel\\Pivot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
